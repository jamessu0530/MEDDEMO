# 複製成 backend/.env 再填值；backend/.env 不會進 git。
# 正式環境不讀這個檔案：金鑰由 GitHub Secrets → K8s Secret 注入，其餘參數寫在 deploy/helm/meddemo/values.yaml 的 config，都是同名的環境變數。
# 沒填的服務會改走手動備援：沒有語音辨識就手動輸入逐字稿，沒有 AI 模型就手動填欄位、問答無法使用。

# 展示時可按「Demo：跳過課程，直接使用 AI」。正式使用改為 false，恢復五關解鎖。
DEMO_SKIP_LEARNING=true

# 展示時每個登入帳號都可切換業務／主管／IT；正式使用設 false，恢復各帳號原本權限。
DEMO_ROLE_SWITCH=true

# GitHub 授權登入：在 https://github.com/settings/developers 建立 OAuth App。
# 正式網站 callback： https://meddemo.jamessu2016.com/auth/github/callback
# 本機開發 callback： http://localhost:5173/auth/github/callback（或實際使用的前端網址）。
# 正式環境填入 GitHub Actions Secrets：OAUTH_GITHUB_CLIENT_ID、OAUTH_GITHUB_CLIENT_SECRET。
# GitHub 禁止 Secret 名稱以 GITHUB_ 開頭；後端環境變數仍使用以下名稱，Client Secret 只供後端使用。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook 登入：在 Meta for Developers 建立 MEDDEMO 專用 App，啟用「Facebook 登入」使用案例或產品。
# 目前使用 JavaScript SDK 彈出視窗，不使用 /auth/facebook/callback。
# 應用程式網域：meddemo.jamessu2016.com；網站網址：https://meddemo.jamessu2016.com/。
# JavaScript SDK 允許的網域：https://meddemo.jamessu2016.com/。
# 有效 OAuth 重新導向 URI：https://meddemo.jamessu2016.com/login 與 /settings（SDK 登入／綁定頁）。
# 隱私政策：https://meddemo.jamessu2016.com/privacy。
# 用戶資料刪除指示：https://meddemo.jamessu2016.com/privacy#delete。
# 一般用戶公開登入需符合 Meta 的權限與發佈要求；2026-10-16 實測新 Consumer App 的
# public_profile 進階存取仍要求商家驗證，僅建立 Consumer App 或切換上線不代表已開放所有人。
# 本機填以下兩項；正式環境填同名 GitHub Actions Secrets。App Secret 只供後端使用。
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# 華語辨識：ASR_PROVIDER 填 gemini 或 local。
# gemini：ASR_MODEL 留空就用 gemini-3.8-flash；ASR_API_KEY 沒填就沿用下面 AI 模型那把。
# local：CARE 的語音辨識服務（faster-whisper），ASR_URL 填它的網址；正式環境寫在 values.yaml 的 config，本機連不到。
# 兩邊都設定時，ASR_PROVIDER 選的是主要來源，另一邊當備援
ASR_PROVIDER=
ASR_API_KEY=
ASR_MODEL=
ASR_URL=

# 華語／台語自動辨識：Taigi AI Labs 的正式台語 STT 金鑰；與華語 ASR_PROVIDER 分開。
# 沒設定時僅可使用華語來源，確認頁會提醒雙語比對未完成；設定後與華語 AI 同時辨識、自動選原文。
TAIGI_API_KEY=
TAIGI_BASE_URL=https://learn-language.tokyo

# AI 模型：抽欄位、數字查詢、知識查詢共用，用 Gemini。LLM_PROVIDER 填 gemini；LLM_MODEL 留空就用 gemini-3.8-flash。
# 金鑰到 Google AI Studio 申請：https://aistudio.google.com/apikey
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# 語意檢索用的 embedding：EMBEDDING_PROVIDER 填 gemini；EMBEDDING_MODEL 留空就用 gemini-embedding-001。
# 沒填的話知識檢索只走關鍵字；EMBEDDING_API_KEY 沒填就沿用 AI 模型那把。
# 設定或換了模型之後，跑 backend/scripts/index_documents.py 重建文件索引，文件段落才會算出向量
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 知識查詢的網路搜尋（Firecrawl）與精排（Cohere），照搬 CARE 的 CRAG。
# 沒填 Firecrawl：知識庫答不出來就直接查無依據、不上網；沒填 Cohere：改用檢索的融合分數排序
FIRECRAWL_API_KEY=
COHERE_API_KEY=

# 問答選「自動」時判斷要查數字、規定還是頻道（TypeSafe Jev，跟 CARE 共用同一把）。沒填就每一題都請業務自己選
TYPESAFE_API_KEY=

# 語音問答（Gemini Live API）：VOICE_API_KEY 沒填就沿用 AI 模型那把；VOICE_MODEL 留空就用 gemini-2.5-flash-native-audio-preview-12-2025。
# 語音問答查資料時用的是上面的 AI 模型，LLM_PROVIDER 也要設定
VOICE_API_KEY=
VOICE_MODEL=

# Google 地圖（行程的道路車程與主管頁的地圖）。都沒填也能用：車程改用直線估算、畫面註明「估計」，主管頁的地圖換成一行說明。
# GOOGLE_MAPS_SERVER_KEY：後端呼叫 Routes API，在 Google Cloud 只開 Routes API，應用程式限制填伺服器的對外 IP。
# GOOGLE_MAPS_BROWSER_KEY：首頁／主管頁地圖與客戶外觀。開 Maps JavaScript API 和 Places API (New)，網站限制填網站網址（本機加 http://localhost:5173/*）。
# GOOGLE_MAPS_MAP_ID：留空就用 Google 給測試用的 DEMO_MAP_ID
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
# Grafana Alloy 抓取 /metrics 用；本機測試自行產生，留空則停用端點。
METRICS_TOKEN=
