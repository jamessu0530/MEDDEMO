{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud 指標資料來源",
      "description": "選擇儲存 MEDDEMO 指標的 Prometheus 資料來源",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "id": null,
  "uid": "meddemo-api",
  "title": "MEDDEMO 系統監控",
  "description": "顯示 MEDDEMO API 的請求量、錯誤率、回應時間，以及 Linux API 程式的 CPU 與記憶體用量。健康檢查與指標抓取不計入 API 流量。",
  "tags": [
    "meddemo",
    "api"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "環境",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(up{job=\"meddemo/api\"}, environment)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": false,
          "text": "production",
          "value": "production"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "指標收集狀態",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"meddemo/api\",environment=~\"$environment\"})",
          "legendFormat": "指標收集狀態",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "尚無資料",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "抓取失敗",
                  "color": "red"
                },
                "1": {
                  "text": "正常",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "顯示 Alloy 是否能成功讀取 API 指標：正常代表抓取成功。"
    },
    {
      "id": 2,
      "title": "每秒請求數",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(meddemo_http_requests_total{job=\"meddemo/api\",environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "每秒請求數",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "尚無資料"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "每秒完成的 API 請求數，不包含健康檢查與指標抓取。"
    },
    {
      "id": 3,
      "title": "伺服器錯誤率（5xx）",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(meddemo_http_requests_total{job=\"meddemo/api\",environment=~\"$environment\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(meddemo_http_requests_total{job=\"meddemo/api\",environment=~\"$environment\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "伺服器錯誤率（5xx）",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "noValue": "尚無資料"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "HTTP 5xx 回應佔所有 API 請求的比例；達到 1% 時顯示紅色。"
    },
    {
      "id": 4,
      "title": "回應時間（p95）",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(meddemo_http_request_duration_seconds_bucket{job=\"meddemo/api\",environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "回應時間（p95）",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "尚無資料"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "95% 的 API 請求會在此時間內完成；達到 1 秒時顯示紅色。"
    },
    {
      "id": 5,
      "title": "各功能的請求量",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method,route) (rate(meddemo_http_requests_total{job=\"meddemo/api\",environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "尚無資料"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "GET /api/auth/me"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "帳號資料"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GET /api/auth/providers"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "登入方式"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GET /api/channels"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "頻道清單"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GET /api/channels/unread"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "未讀數"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GET /api/customers"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "客戶清單"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GET /api/customers/{customer_id}"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "客戶資料"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GET /api/products"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "商品型錄"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "POST /api/auth/login"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "登入"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "依 HTTP 方法與 API 路由分組，顯示每秒請求數。"
    },
    {
      "id": 6,
      "title": "各功能的回應時間（p95）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,method,route) (rate(meddemo_http_request_duration_seconds_bucket{job=\"meddemo/api\",environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "尚無資料"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "GET /api/auth/me"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "帳號資料"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GET /api/auth/providers"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "登入方式"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GET /api/channels"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "頻道清單"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GET /api/channels/unread"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "未讀數"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GET /api/customers"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "客戶清單"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GET /api/customers/{customer_id}"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "客戶資料"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GET /api/products"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "商品型錄"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "POST /api/auth/login"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "登入"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "各 API 功能有 95% 的請求會在此時間內完成。"
    },
    {
      "id": 7,
      "title": "HTTP 回應狀態分布",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(meddemo_http_requests_total{job=\"meddemo/api\",environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "狀態碼 {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "尚無資料"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "依 HTTP 狀態碼顯示每秒回應數，例如 200 成功、401 未登入、500 伺服器錯誤。"
    },
    {
      "id": 8,
      "title": "API 記憶體用量",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"meddemo/api\",environment=~\"$environment\"}",
          "legendFormat": "API 實例 {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "尚無資料"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "API 程式實際占用的記憶體（RSS），僅提供 Linux 的資料；macOS 本機驗證期間不會產生此指標。"
    },
    {
      "id": 9,
      "title": "API CPU 用量（核心數）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"meddemo/api\",environment=~\"$environment\"}[$__rate_interval])",
          "legendFormat": "API 實例 {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "尚無資料"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "API 程式使用的 CPU 核心數，例如 0.5 代表半顆核心；僅提供 Linux 的資料。"
    },
    {
      "id": 10,
      "title": "處理中的請求數",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(meddemo_http_requests_in_progress{job=\"meddemo/api\",environment=~\"$environment\"})",
          "legendFormat": "處理中的請求數",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "尚無資料"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "目前尚未完成的 API 請求數。"
    }
  ]
}
